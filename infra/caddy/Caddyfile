{$IMLADRIS_SITE::80} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy imladris-api:3000
	}

	handle /ws/* {
		reverse_proxy imladris-api:3000
	}

	handle /health {
		reverse_proxy imladris-api:3000
	}

	handle {
		reverse_proxy imladris-web:80
	}
}
