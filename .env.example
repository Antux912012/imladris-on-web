# Imladris on Web Environment Configuration
IMLADRIS_MODE=local
AUTH_MODE=team
REGISTRATION_MODE=open
ALLOWED_EMAIL_DOMAINS=
AIR_GAPPED_MODE=false
PUBLIC_URL=http://localhost:8080
IMLADRIS_DOMAIN=localhost
JWT_SECRET=change-me-64-hex-chars-for-production-deployments-only-local-auto
RUNNER_SHARED_SECRET=change-me-64-hex-chars-for-runner-auth-only-local-auto
DATABASE_URL=file:/data/db/imladris.sqlite
WORKSPACES_ROOT=/data/workspaces
RUNNER_URL=http://imladris-runner:9000
RUNNER_EXEC_TIMEOUT_MS=60000
AI_LOCAL_URL=http://imladris-ollama:11434
AI_ALLOW_CLOUD=false
