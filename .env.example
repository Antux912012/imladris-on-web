# Imladris on Web Environment Configuration
IMLADRIS_MODE=local
AUTH_MODE=team
REGISTRATION_MODE=invite
ALLOWED_EMAIL_DOMAINS=
AIR_GAPPED_MODE=false

# Network / Nginx / CORS
NGINX_HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
IMLADRIS_DOMAIN=localhost
CORS_ORIGINS=*

# Secrets (change in production!)
JWT_SECRET=change-me-64-hex-chars-for-production-deployments-only-local-auto
RUNNER_SHARED_SECRET=change-me-64-hex-chars-for-runner-auth-only-local-auto

# PostgreSQL Database (Docker Compose)
POSTGRES_DB=imladris
POSTGRES_USER=imladris
POSTGRES_PASSWORD=imladris-db-password
DATABASE_URL=postgresql://imladris:imladris-db-password@imladris-db:5432/imladris

# Optional Bootstrap Admin Account (created automatically on startup when password is set)
ADMIN_EMAIL=admin@imladris.local
ADMIN_DISPLAY_NAME=Administrator
ADMIN_PASSWORD=

# Workspaces & Runner
WORKSPACES_ROOT=/data/workspaces
RUNNER_URL=http://imladris-runner:9000
RUNNER_EXEC_TIMEOUT_MS=60000
AI_LOCAL_URL=http://imladris-ollama:11434
AI_ALLOW_CLOUD=false
